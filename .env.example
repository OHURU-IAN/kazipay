# Copy to .env.local and fill in. Without PayPal keys the app runs on built-in demo data.

# AI provider: gemini (free tier) or anthropic. If unset, whichever key is present is used.
AI_PROVIDER=gemini

# Google Gemini - free key at https://aistudio.google.com/api-keys
GEMINI_API_KEY=
# Optional: model or comma-separated fallback chain (default gemini-3.5-flash-lite,gemini-3.1-flash-lite)
GEMINI_MODEL=

# Claude - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
ANTHROPIC_MODEL=

# PayPal REST app (Sandbox) - https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_ENV=sandbox
# Optional: webhook ID from the PayPal dashboard, for /api/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# Optional: chat messages allowed per IP per 10 minutes (protects your AI quota on a public demo)
CHAT_RATE_LIMIT=30
